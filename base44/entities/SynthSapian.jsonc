{
  "name": "SynthSapian",
  "type": "object",
  "properties": {
    "agent_id": { "type": "string", "pattern": "^WC(?:0[1-9]|[1-9][0-9]*)$", "description": "Immutable Wilkerson Collective Agent ID, e.g. WC04 or WC104." },
    "name": { "type": "string" },
    "role": { "type": "string" },
    "department": { "type": "string" },
    "sector": { "type": "string" },
    "tier": { "type": "string", "enum": ["leadership", "specialist", "support"], "default": "specialist" },
    "description": { "type": "string" },
    "specialty": { "type": "string" },
    "why_it_matters": { "type": "string" },
    "skills": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "tools": { "type": "array", "items": { "type": "string" } },
    "model_configuration": { "type": "object" },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "state": { "type": "string", "enum": ["idle", "working", "blocked", "awaiting_approval", "completed", "failed"], "default": "idle" },
    "security_status": { "type": "string", "enum": ["pending", "passed", "failed"], "default": "pending" },
    "capability_gate_checks": { "type": "object" },
    "current_deployment": { "type": ["string", "null"] },
    "availability": { "type": "string", "enum": ["available", "deployed", "customizing", "offline"], "default": "available" },
    "training_history": { "type": "array", "items": { "type": "object" } },
    "performance_history": { "type": "array", "items": { "type": "object" } },
    "version": { "type": "string" },
    "fingerprint": { "type": "string" },
    "parent_agent_id": { "type": ["string", "null"] },
    "child_agent_ids": { "type": "array", "items": { "type": "string" } },
    "escalation_owner": { "type": ["string", "null"] },
    "audit_history": { "type": "array", "items": { "type": "object" } },
    "image_url": { "type": "string" },
    "daily_rate": { "type": "number" },
    "region_scope": { "type": "string", "default": "Global" },
    "avatar_gradient": { "type": "string" }
  },
  "required": ["agent_id", "name", "role", "department", "skills", "permissions", "state", "security_status"]
}
